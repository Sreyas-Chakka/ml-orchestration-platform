{
  "uid": "mlops-jobs",
  "title": "ML Job Orchestration",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active runs",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(mlops_active_runs)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(mlops_queue_depth)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Capacity",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(mlops_capacity)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stalls (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mlops_stall_detections_total[24h]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failures (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mlops_runs_finished_total{status=\"failed\"}[24h]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Oldest heartbeat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(mlops_oldest_heartbeat_age_seconds)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Runs by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (mlops_runs)",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue depth vs active",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(mlops_queue_depth)",
          "legendFormat": "queued",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "max(mlops_active_runs)",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "C",
          "expr": "max(mlops_capacity)",
          "legendFormat": "capacity",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Finished runs / 5m by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(mlops_runs_finished_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Run duration p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mlops_run_duration_seconds_bucket[30m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mlops_run_duration_seconds_bucket[30m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queue wait p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mlops_queue_wait_seconds_bucket[15m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Retries, dispatch errors, analyses",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mlops_runs_retried_total[10m]))",
          "legendFormat": "retries",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(mlops_dispatch_errors_total[10m]))",
          "legendFormat": "dispatch errors",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (source) (increase(mlops_analyses_total[10m]))",
          "legendFormat": "analyses ({{source}})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "tags": [
    "mlops"
  ]
}